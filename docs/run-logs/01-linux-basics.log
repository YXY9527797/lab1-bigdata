fi

export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"  # This loads nvm
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"  # This loads nvm bash_completion

-- (2) 查看 ~/.bashrc，并且只列出 50 行以后的数据
$ tail -n +51 ~/.bashrc     # +51 表示从第 51 行开始输出到末尾
$ tail -n +51 /home/yxy/.bashrc
	# (ISO/IEC-6429). (Lack of such support is extremely rare, and such
	# a case would tend to support setf rather than setaf.)
	color_prompt=yes
    else
	color_prompt=
    fi
fi

if [ "$color_prompt" = yes ]; then
    PS1='${debian_chroot:+($debian_chroot)}\[\033[01;32m\]\u@\h\[\033[00m\]:\[\033[01;34m\]\w\[\033[00m\]\$ '
else
    PS1='${debian_chroot:+($debian_chroot)}\u@\h:\w\$ '
fi
unset color_prompt force_color_prompt

# If this is an xterm set the title to user@host:dir
case "$TERM" in
xterm*|rxvt*)
    PS1="\[\e]0;${debian_chroot:+($debian_chroot)}\u@\h: \w\a\]$PS1"
    ;;
*)
    ;;
esac

# enable color support of ls and also add handy aliases
if [ -x /usr/bin/dircolors ]; then
    test -r ~/.dircolors && eval "$(dircolors -b ~/.dircolors)" || eval "$(dircolors -b)"
    alias ls='ls --color=auto'
    #alias dir='dir --color=auto'
    #alias vdir='vdir --color=auto'

    alias grep='grep --color=auto'
    alias fgrep='fgrep --color=auto'
    alias egrep='egrep --color=auto'
fi

# colored GCC warnings and errors
#export GCC_COLORS='error=01;31:warning=01;35:note=01;36:caret=01;32:locus=01:quote=01'

# some more ls aliases
alias ll='ls -alF'
alias la='ls -A'
alias l='ls -CF'

# Add an "alert" alias for long running commands.  Use like so:
#   sleep 10; alert
alias alert='notify-send --urgency=low -i "$([ $? = 0 ] && echo terminal || echo error)" "$(history|tail -n1|sed -e '\''s/^\s*[0-9]\+\s*//;s/[;&|]\s*alert$//'\'')"'

# Alias definitions.
# You may want to put all your additions into a separate file like
# ~/.bash_aliases, instead of adding them here directly.
# See /usr/share/doc/bash-doc/examples in the bash-doc package.

if [ -f ~/.bash_aliases ]; then
    . ~/.bash_aliases
fi

# enable programmable completion features (you don't need to enable
# this, if it's already enabled in /etc/bash.bashrc and /etc/profile
# sources /etc/bash.bashrc).
if ! shopt -oq posix; then
  if [ -f /usr/share/bash-completion/bash_completion ]; then
    . /usr/share/bash-completion/bash_completion
  elif [ -f /etc/bash_completion ]; then
    . /etc/bash_completion
  fi
fi

export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"  # This loads nvm
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"  # This loads nvm bash_completion

────────────────────────────────────────────────────────────────────────
【13】touch 命令：修改文件时间或创建新文件
────────────────────────────────────────────────────────────────────────
-- (1) 在 /tmp 下创建一个空文件 hello，并查看文件时间
$ touch /tmp/hello
$ ls -l --time-style=full-iso /tmp/hello
-rw-rw-r-- 1 root root 0 2026-10-02 00:15:10.071338808 +0800 /tmp/hello
$ stat /tmp/hello
  文件：/tmp/hello
  大小：0         	块：0          IO 块大小：4096   普通空文件
设备：53h/83d	Inode：45          硬链接：1
权限：(0664/-rw-rw-r--)  Uid: (    0/    root)   Gid: (    0/    root)
访问时间：2026-10-02 00:15:10.071338808 +0800
修改时间：2026-10-02 00:15:10.071338808 +0800
变更时间：2026-10-02 00:15:10.071338808 +0800
创建时间：2026-10-02 00:15:10.071338808 +0800

-- (2) 修改 hello 文件，将文件时间整为 5 天前
$ touch -d 5 days ago /tmp/hello
$ ls -l --time-style=full-iso /tmp/hello
-rw-rw-r-- 1 root root 0 2026-09-27 00:15:10.077386436 +0800 /tmp/hello
$ date -d '5 days ago'
2026年 09月 27日 星期日 00:15:10 CST

────────────────────────────────────────────────────────────────────────
【14】chown 命令：修改文件所有者权限
────────────────────────────────────────────────────────────────────────
-- 将 hello 文件所有者改为 root 帐号，并查看属性
$ chown root /tmp/hello
$ ls -l /tmp/hello
-rw-rw-r-- 1 root root 0  9月 27 00:15 /tmp/hello
$ stat -c '文件=%n 属主=%U 属组=%G 权限=%A' /tmp/hello
文件=/tmp/hello 属主=root 属组=root 权限=-rw-rw-r--

────────────────────────────────────────────────────────────────────────
【15】find 命令：文件查找
────────────────────────────────────────────────────────────────────────
-- 找出主文件夹下文件名为 .bashrc 的文件
$ find ~ -name .bashrc
$ find /home/yxy -name .bashrc
/home/yxy/.bashrc

────────────────────────────────────────────────────────────────────────
【16】tar 命令：压缩命令
────────────────────────────────────────────────────────────────────────
-- (1) 在根目录 / 下新建文件夹 test，然后在根目录 / 下打包成 test.tar.gz
$ mkdir /test
$ touch /test/file1.txt /test/file2.txt
$ ls -l /test
总计 0
-rw-rw-r-- 1 root root 0 10月  2 00:15 file1.txt
-rw-rw-r-- 1 root root 0 10月  2 00:15 file2.txt
$ cd /
当前目录：/
$ tar -czf /test.tar.gz test
$ ls -lh /test.tar.gz
-rw-rw-r-- 1 root root 150 10月  2 00:15 /test.tar.gz
$ tar -tzvf /test.tar.gz   # 查看压缩包内容
$ tar -tzvf /test.tar.gz
drwxrwxr-x root/root         0 2026-10-02 00:15 test/
-rw-rw-r-- root/root         0 2026-10-02 00:15 test/file1.txt
-rw-rw-r-- root/root         0 2026-10-02 00:15 test/file2.txt

-- (2) 把上面的 test.tar.gz 压缩包解压缩到 /tmp 目录
$ tar -xzf /test.tar.gz -C /tmp
$ ls -l /tmp/test
总计 0
-rw-rw-r-- 1 root root 0 10月  2 00:15 file1.txt
-rw-rw-r-- 1 root root 0 10月  2 00:15 file2.txt

