-- 为 hadoop 用户创建 HDFS 用户目录 /user/hadoop
$ hdfs dfs -mkdir -p /user/hadoop
$ hdfs dfs -chown hadoop:supergroup /user/hadoop    # 属主改为 hadoop 用户
$ hdfs dfs -ls -d /user/hadoop
drwxr-xr-x   - hadoop supergroup          0 2026-10-02 00:17 /user/hadoop

