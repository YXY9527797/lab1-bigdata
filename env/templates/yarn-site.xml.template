<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="configuration.xsl"?>
<!--
  yarn-site.xml —— 单节点 YARN 配置（ResourceManager + NodeManager 同机）
  NodeManager 上的 shuffle 服务是 MapReduce 的 Reduce 阶段拉取 Map 输出的必需服务
-->
<configuration>
  <property>
    <name>yarn.nodemanager.aux-services</name>
    <value>mapreduce_shuffle</value>
  </property>
  <property>
    <name>yarn.nodemanager.aux-services.mapreduce_shuffle.class</name>
    <value>org.apache.hadoop.mapred.ShuffleHandler</value>
  </property>
  <property>
    <name>yarn.resourcemanager.hostname</name>
    <value>localhost</value>
  </property>
  <!--
    容器可以继承的环境变量白名单：
      * HADOOP_MAPRED_HOME 必须包含，否则容器找不到 MapReduce 依赖；
      * LANG/LC_ALL/LANGUAGE 也必须包含：本实验目录路径中含有中文（“文档”），
        容器里若没有 UTF-8 的 locale，JVM 会把路径中的中文转成 '?'，导致
        container-launch 创建日志目录失败（本实验真实踩到过这个坑）。
  -->
  <property>
    <name>yarn.nodemanager.env-whitelist</name>
    <value>JAVA_HOME,HADOOP_COMMON_HOME,HADOOP_HDFS_HOME,HADOOP_CONF_DIR,CLASSPATH_PREPEND_DISTCACHE,HADOOP_YARN_HOME,HADOOP_MAPRED_HOME,LANG,LC_ALL,LANGUAGE,TZ</value>
  </property>
  <property>
    <name>yarn.nodemanager.local-dirs</name>
    <value>@LAB_ROOT@/env/yarn/local</value>
  </property>
  <property>
    <name>yarn.nodemanager.log-dirs</name>
    <value>@LAB_ROOT@/env/yarn/logs</value>
  </property>
  <property>
    <name>yarn.nodemanager.resource.memory-mb</name>
    <value>3072</value>
  </property>
  <property>
    <name>yarn.scheduler.maximum-allocation-mb</name>
    <value>3072</value>
  </property>
  <property>
    <name>yarn.scheduler.minimum-allocation-mb</name>
    <value>512</value>
  </property>
  <!-- 实验用小程序，关闭物理/虚拟内存检查，避免容器因内存超限被杀 -->
  <property>
    <name>yarn.nodemanager.pmem-check-enabled</name>
    <value>false</value>
  </property>
  <property>
    <name>yarn.nodemanager.vmem-check-enabled</name>
    <value>false</value>
  </property>
</configuration>
